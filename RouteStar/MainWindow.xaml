<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RouteStar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RouteStar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RouteStar">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <WebView2 x:Name="LauncherWebView" />

        <!-- 启动遮罩层：防止 WebView2 载入时的闪烁和穿帮 -->
        <Grid x:Name="LoadingMask" Background="#0F111A">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <ProgressRing IsActive="True" Width="48" Height="48" Foreground="#3B82F6" />
                <TextBlock Text="正在启动 RouteStar..." 
                           Foreground="White" 
                           Opacity="0.6"
                           HorizontalAlignment="Center" 
                           FontSize="14" />
            </StackPanel>
        </Grid>

        <!-- 将原生 TitleBar 区域设为0，消除事件拦截，由 WebView2 CSS属性接管 -->
        <Border x:Name="AppTitleBar" Width="0" Height="0" />
    </Grid>
</Window>
